    <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets"/>
    <ImportGroup Label="ExtensionTargets"/>

    <!-- Sierra Chart deployment. Runs only when AcsilMcp.user.props lists SierraChartInstance items
         and SkipSierraChartDeploy is not true
         (see AcsilMcp.user.props.example); CI and fresh clones skip it.
         Pre-build: ask each running SC instance to release its study DLLs so the file is unlocked.
         Post-build: copy the DLL and PDB into each instance's Data folder, then allow DLL loading again.
         ScUdpCommand never fails the build when SC is not running. -->
    <Target Name="ReleaseSierraChartDlls" BeforeTargets="PreBuildEvent" Condition="'@(SierraChartInstance)' != '' And '$(SkipSierraChartDeploy)' != 'true'">
        <Exec Command="dotnet build &quot;$(ScUdpCommandProject)&quot; -c $(Configuration) -nologo -v q"/>
        <Exec Command="&quot;$(ScUdpCommandExe)&quot; RELEASE_ALL_DLLS %(SierraChartInstance.UdpPort) 500"/>
    </Target>
    <Target Name="DeployToSierraChart" AfterTargets="PostBuildEvent" Condition="'@(SierraChartInstance)' != '' And '$(SkipSierraChartDeploy)' != 'true'">
        <Copy SourceFiles="$(TargetDir)$(TargetName).dll;$(TargetDir)$(TargetName).pdb"
              DestinationFolder="%(SierraChartInstance.Identity)\Data"
              Retries="3" RetryDelayMilliseconds="500"/>
        <Exec Command="&quot;$(ScUdpCommandExe)&quot; ALLOW_LOAD_ALL_DLLS %(SierraChartInstance.UdpPort) 0"/>
    </Target>
</Project>
